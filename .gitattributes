# Keep binary assets byte-exact (the MediaPipe model + any images must never be
# line-ending normalized — a corrupted .task fails to load at runtime).
*.task binary
*.tflite binary
*.png binary
*.jpg binary
*.webp binary
*.jar binary
*.keystore binary

# Normalize line endings for text sources.
*.kt text eol=lf
*.kts text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.pro text eol=lf
